{
  "name": "arc-academy",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm test && npm run build && npm run test:e2e",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests e2e scripts/*.mjs scripts/sw-template.js *.ts *.json index.html .github/workflows/*.yml README.md"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "fake-indexeddb": "^6.2.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^7.2.0",
    "vitest": "^3.2.4"
  }
}
